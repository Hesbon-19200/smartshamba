# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WEATHER_API_KEY: Optional external weather provider (e.g. OpenWeatherMap or Tomorrow.io).
# When omitted, MkulimaAI utilizes Kenya Agro-Meteorological Live Feed / Demo mode.
WEATHER_API_KEY=""

# MARKET_DATA_API_KEY: Optional Kenya Agricultural Commodity Price API key.
# When omitted, MkulimaAI utilizes authentic Kenya Ministry of Agriculture / KALRO market reference tables.
MARKET_DATA_API_KEY=""

# DATABASE_URL: Optional PostgreSQL connection string for Prisma.
# Defaults to embedded high-performance persistence engine.
DATABASE_URL="postgresql://user:password@localhost:5432/mkulima_ai"

